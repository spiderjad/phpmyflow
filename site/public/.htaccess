# phpMyFlow website (site/dist → public_html/phpmyflow/). Apache or LiteSpeed (Hostinger).
# These rules also reach /demo/ (HTTPS and the generic headers). The site's
# Content-Security-Policy is a <meta> tag in each page, so it never touches the demo.

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

# HTTPS always (also behind a proxy that sets X-Forwarded-Proto).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

AddType image/avif .avif
AddType image/webp .webp
AddType font/woff2 .woff2
AddType application/xml .xml
AddCharset utf-8 .html .css .js .txt .xml .svg

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"

  # Pages: always revalidate (a new upload is visible at once).
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Icons and the social image: one week (same names across builds).
  <FilesMatch "\.(svg|png|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
# Assets with a content hash in the name (_astro/): a year, immutable. See _astro/.htaccess.

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript text/javascript application/xml image/svg+xml
</IfModule>
