---
// Every page: <head> (title, description, canonical, hreflang, Open Graph,
// Twitter card, CSP, JSON-LD), skip link, header and footer.
import '../styles/fonts.css';
import 'spider-ui/tokens.css';
import 'spider-ui/panel.css';
import '../styles/site.css';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ANALYTICS, CSP_CONNECT_EXTRA, CSP_SCRIPT_EXTRA, SITE_URL } from '../config';
import { DEFAULT_LOCALE, ENABLED_LOCALES, homePath, localeInfo, messages, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** Pages that exist in every language (the home page) get hreflang links. */
  alternates?: boolean;
  jsonLd?: object[];
  noindex?: boolean;
}
const { locale, title, description, alternates = false, jsonLd = [], noindex = false } = Astro.props;
const t = messages(locale);
const info = localeInfo(locale);
const abs = (path: string): string => new URL(path, SITE_URL).href;
const canonical = abs(alternates ? homePath(locale) : Astro.url.pathname);
const ogImage = abs(`/og/og-${locale}.png`);

// Only 'self' (plus what config.ts adds for analytics). No inline scripts or styles:
// JSON-LD is data (type application/ld+json), not script.
const csp = [
  "default-src 'self'",
  `script-src 'self' ${CSP_SCRIPT_EXTRA.join(' ')}`.trim(),
  "style-src 'self'",
  "img-src 'self' data:",
  "font-src 'self'",
  `connect-src 'self' ${CSP_CONNECT_EXTRA.join(' ')}`.trim(),
  "base-uri 'self'",
  "form-action 'self'",
  "object-src 'none'",
].join('; ');
// "<" escaped: the JSON can never close the <script> that holds it.
const json = (data: object): string => JSON.stringify(data).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang={info.hreflang} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="Content-Security-Policy" content={csp} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      alternates &&
        ENABLED_LOCALES.map((l) => <link rel="alternate" hreflang={l.hreflang} href={abs(homePath(l.code))} />)
    }
    {alternates && <link rel="alternate" hreflang="x-default" href={abs(homePath(DEFAULT_LOCALE))} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="phpMyFlow" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={info.ogLocale} />
    {
      alternates &&
        ENABLED_LOCALES.filter((l) => l.code !== locale).map((l) => (
          <meta property="og:locale:alternate" content={l.ogLocale} />
        ))
    }
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={t.meta.ogImageAlt} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    {jsonLd.map((data) => <script type="application/ld+json" set:html={json(data)} />)}
    {ANALYTICS && <script src={ANALYTICS.src} defer {...ANALYTICS.attrs ?? {}} />}
  </head>
  <body>
    <a class="ws-skip" href="#main">{t.a11y.skip}</a>
    <Header locale={locale} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer locale={locale} />
    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>
