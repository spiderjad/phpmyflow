---
// A screenshot of the app in light and dark (src/assets/shots/<id>-<mode>.png,
// made by scripts/shots.mjs): one <picture> with AVIF and WebP in several
// widths; the dark one is chosen by the browser when the system is dark.
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  id: string;
  alt: string;
  /** CSS width the image takes, for the browser to pick a size. */
  sizes: string;
  widths: number[];
  /** The hero: loaded first (LCP), the rest lazily. */
  priority?: boolean;
  class?: string;
}
const { id, alt, sizes, widths, priority = false, class: className } = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/shots/*.png', { eager: true });
const source = (mode: 'light' | 'dark'): ImageMetadata => {
  const f = files[`../assets/shots/${id}-${mode}.png`];
  if (!f) throw new Error(`Missing screenshot ${id}-${mode}.png: run npm run shots`);
  return f.default;
};

const QUALITY = { avif: 55, webp: 72 } as const;
async function srcset(img: ImageMetadata, format: 'avif' | 'webp'): Promise<string> {
  const ws = widths.filter((w) => w <= img.width);
  const out = await Promise.all(ws.map((width) => getImage({ src: img, width, format, quality: QUALITY[format] })));
  return out.map((o, i) => `${o.src} ${ws[i]}w`).join(', ');
}

const light = source('light');
const dark = source('dark');
const [lightAvif, lightWebp, darkAvif, darkWebp] = await Promise.all([
  srcset(light, 'avif'),
  srcset(light, 'webp'),
  srcset(dark, 'avif'),
  srcset(dark, 'webp'),
]);
const fallback = await getImage({ src: light, width: widths[Math.min(1, widths.length - 1)], format: 'webp', quality: QUALITY.webp });
// Same aspect ratio for every width: the space is reserved before the image arrives (no layout shift).
const width = fallback.attributes.width ?? light.width;
const height = Math.round((Number(width) * light.height) / light.width);
const dm = '(prefers-color-scheme: dark)';
---

<picture class={className}>
  <source media={dm} type="image/avif" srcset={darkAvif} sizes={sizes} />
  <source media={dm} type="image/webp" srcset={darkWebp} sizes={sizes} />
  <source type="image/avif" srcset={lightAvif} sizes={sizes} />
  <source type="image/webp" srcset={lightWebp} sizes={sizes} />
  <img
    src={fallback.src}
    width={width}
    height={height}
    alt={alt}
    sizes={sizes}
    loading={priority ? 'eager' : 'lazy'}
    decoding={priority ? 'sync' : 'async'}
    fetchpriority={priority ? 'high' : 'auto'}
  />
</picture>
